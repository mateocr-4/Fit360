{
  "name": "fit360",
  "version": "1.1.0",
  "description": "Fit360 - Fitness & Nutrition Tracker para iOS",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --port=3000",
    "start": "live-server --port=3000",
    "build": "node build_dist.js",
    "assets:generate": "node scripts/generate_assets_source.js && npx @capacitor/assets generate --ios",
    "bump:build": "node scripts/bump_version.js",
    "bump:version": "node scripts/bump_version.js",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "node build_dist.js && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "cap:build": "node build_dist.js && npx cap sync ios && npx cap open ios",
    "build:ios": "node build_dist.js && npx cap sync ios",
    "prepare:ios": "node build_dist.js && echo '✅ www/ listo. Ahora ejecuta: npx cap sync ios (en Mac con Xcode)'"
  },
  "author": "Mateo",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor-community/apple-sign-in": "^6.0.0",
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@followathletics/capacitor-healthkit": "^1.3.7",
    "@supabase/supabase-js": "^2.117.2",
    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "live-server": "^1.2.2"
  }
}
